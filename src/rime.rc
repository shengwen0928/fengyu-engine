      VALUE "OriginalFilename", "@original_filename@"
      VALUE "ProductName", "風語輸入法引擎"
      VALUE "ProductVersion", "@rime_version@@tag_suffix@"
    END
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AIW 風光Ai窗"
      VALUE "FileDescription", "風語輸入法引擎"
      VALUE "InternalName", "fengyucore"
      VALUE "LegalCopyright", "AIW 風光Ai窗"
      VALUE "OriginalFilename", "@original_filename@"
      VALUE "ProductName", "風語輸入法引擎"
      VALUE "ProductVersion", "@rime_version@@tag_suffix@"
    END
#endif
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "AIW Fengguang Ai Window"
      VALUE "FileDescription", "Fengyu IME Engine"
      VALUE "InternalName", "fengyucore"
      VALUE "LegalCopyright", "AIW Fengguang Ai Window"
      VALUE "OriginalFilename", "@original_filename@"
      VALUE "ProductName", "Fengyu IME Engine"
      VALUE "ProductVersion", "@rime_version@@tag_suffix@"
